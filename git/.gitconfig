[alias]
  aa = add --all
  ap = add --patch
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  ci = commit -v
  cm = commit -m
  co = checkout
  fp = fetch -p
  pl = pull
  pf = push -f
  ro = rebase origin/main
  rio = rebase -i origin/main
  st = status
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  delete-squashed = "!f() { local targetBranch=${1:-main} && git checkout -q $targetBranch && local wtBranches=$(git worktree list --porcelain | grep '^branch refs/heads/' | sed 's|^branch refs/heads/||') && git branch --merged | grep -v '[*+]' | while read branch; do echo \"$wtBranches\" | grep -qx \"$branch\" || git branch -d \"$branch\"; done && git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do echo \"$wtBranches\" | grep -qx \"$branch\" && continue; mergeBase=$(git merge-base $targetBranch $branch) && [[ $(git cherry $targetBranch $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == \"-\"* ]] && git branch -D $branch; done; }; f"
  ignore = "!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi"
[merge]
  ff = only
[fetch]
  prune = true
[rebase]
  autosquash = true
[user]
	name = Kevin Marlow
	email = kevinmmarlow@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHUvEpfFHmddq9U39IQbChz4LnNXU9juraEGgz2zpqC3
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
  gpgsign = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[core]
	excludesfile = /Users/kevinmarlow/.gitignore
[stash]
	showIncludeUntracked = true
[url "git@github.com:angellist/"]
	insteadOf = https://github.com/angellist/
