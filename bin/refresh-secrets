#!/usr/bin/env bash
# Regenerate ~/.zsh/secrets.zsh from 1Password.
#
# Secrets are cached in a gitignored file so interactive shells never call `op`
# at startup (fast, no biometric prompt per shell). Run this once per machine
# during bootstrap, and again whenever you rotate one of these keys.

set -euo pipefail

DEST="$HOME/.zsh/secrets.zsh"
ACCOUNT="my.1password.com"
VAULT="Private"

if ! command -v op >/dev/null; then
  echo "refresh-secrets: 1Password CLI (op) not found; install it first" >&2
  exit 1
fi

# op emits raw JSON; jq -r extracts the unquoted field value.
# The field handle matches either the field id or its label.
op_field() { # item_id  field_id_or_label
  op item get "$1" --account "$ACCOUNT" --vault "$VAULT" --reveal --format json \
    | jq -r --arg fid "$2" '.fields[] | select(.id == $fid or .label == $fid).value'
}

op account get --account "$ACCOUNT" >/dev/null 2>&1 || eval "$(op signin --account "$ACCOUNT")"

anthropic="$(op_field s55bx4qielz7yggnvmgb3weyqe password)"
github="$(op_field dgph4fe72p6nwn45ixbbnjvr4a iaaylz5hl46kf7wrnf6ows5os4)"
obsidian="$(op_field r55flbwl2n4btus5ui5ackj5le password)"
cloudflare="$(op_field 2kfqngvzbsmpi3zbua6hx72ypm "API Key")"

umask 077
{
  echo "# Generated by refresh-secrets from 1Password. DO NOT COMMIT. DO NOT EDIT."
  printf 'export ANTHROPIC_API_KEY=%q\n' "$anthropic"
  printf 'export GITHUB_PERSONAL_ACCESS_TOKEN=%q\n' "$github"
  printf 'export OBSIDIAN_API_KEY=%q\n' "$obsidian"
  printf 'export CLOUDFLARE_API_KEY=%q\n' "$cloudflare"
} > "$DEST"
chmod 600 "$DEST"

echo "refresh-secrets: wrote $DEST"
