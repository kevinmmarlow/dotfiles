# macOS
.DS_Store

# Secrets: never committed. Generated to ~/.zsh/secrets.zsh (outside this repo);
# these patterns are defensive in case one ever lands in the tree.
**/secrets.zsh
**/*.local
**/*.local.json

# Machine-local overrides
git/.gitconfig.local
zsh/.zsh/*.local

# Claude Code: only intentional config is tracked, never state
claude/.claude/settings.local.json

# Theme state: which theme is currently active (per machine)
config/.config/themes/current

# Kitty active theme: a symlink into themes/kitty/, repointed by `theme -k`
config/.config/kitty/current-theme.conf

# zsh compiled completion dumps
.zcompdump*
